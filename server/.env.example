# Optional external telemetry destination and metadata.
# OTEL_EXPORTER_OTLP_ENDPOINT="<otel_endpoint>"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=ApiKey <apikey>"
# OTEL_SERVICE_NAME="<service_name>"
# OTEL_RESOURCE_ATTRIBUTES="deployment.environment=Development,service.namespace=<service_namespace>"

# auth
# Auth__ClientId="<client-guid>"
# Optional fictional users, accepted only in Development. The Docker sandbox enables this.
Auth__UseLocal="false"

# database
DB_CONNECTION="Server=localhost,14335;Database=Booking;User ID=sa;Password=LocalDev123!;Encrypt=False;TrustServerCertificate=True;"
# Migrations always run. Set true to seed fixed sample records when the weather table is empty.
DevelopmentData__SeedOnStartup="false"
# Optional comma-separated IAM IDs to grant Users.IsAdmin on their next login, only in Development.
# Users need not exist yet. Removing an ID does not revoke its saved admin status.
DevelopmentData__AdminIamIds=""
# DevelopmentData__AdminIamIds="sandbox-10001,sandbox-10002"

# Optional SMTP delivery: leave Host empty until email is configured.
Smtp__Host=""
# Smtp__Host="<smtp_host>"
# Smtp__Port="587"
# Smtp__Timeout="100000"
# Smtp__UseSsl="true"
# Smtp__Username="<smtp_username>"
# Smtp__Password="<smtp_password>"
# Smtp__FromEmail="no-reply@example.test"
# Smtp__FromName="<app_display_name>"
# Smtp__ReplyToEmail=""
# Smtp__BccEmail=""

# Optional notification example defaults
# Notification__BaseUrl="http://localhost:5173"
# Notification__DefaultAppName="<app_display_name>"
# Notification__DefaultButtonText="Open the application"
