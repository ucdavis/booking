@model string
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Local sign-in | Booking</title>
    <style>
        body { margin: 0; background: #f2f5f8; color: #172b40; font-family: system-ui, sans-serif; }
        main { max-width: 560px; margin: 10vh auto; padding: 32px; background: white; border-top: 6px solid #ffbf00; border-radius: 8px; }
        h1 { color: #022851; }
        p { line-height: 1.6; }
        button { display: block; width: 100%; padding: 16px; margin-top: 16px; text-align: left; border: 1px solid #b8c6d3; border-radius: 6px; background: white; color: #022851; font: inherit; cursor: pointer; }
        button:hover { background: #eef4fa; }
        button:disabled { cursor: not-allowed; opacity: 0.6; }
        button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid #13639e; outline-offset: 3px; }
        button span { display: block; margin-top: 6px; font-size: 14px; }
        .person-sign-in { margin-top: 28px; padding-top: 12px; border-top: 1px solid #d6dfe7; }
        label { display: block; margin-bottom: 8px; font-weight: 600; }
        input[type="text"] { box-sizing: border-box; width: 100%; padding: 12px; border: 1px solid #b8c6d3; border-radius: 6px; font: inherit; }
        .hint { font-size: 14px; }
        .validation-error { display: block; margin-top: 12px; color: #9b1c20; }
        a { color: #00588a; }
    </style>
</head>
<body>
<main>
    <p>Booking · Local development</p>
    <h1>Choose a local user</h1>
    <p>Local sign-in works without Entra or a password. Basic User lets you check access denied responses.</p>
    <form action="/login/local" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Model" />
        <button name="persona" value="basic" type="submit">
            <strong>Sign in as Basic User</strong>
            <span>basic@example.test · User only</span>
        </button>
    </form>
    <section class="person-sign-in" aria-labelledby="person-sign-in-heading">
        <h2 id="person-sign-in-heading">Sign in as a person</h2>
        <p>Find an existing Booking user or a person in the campus directory to try their site and team access.</p>
        <form action="/login/local/person" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model" />
            <label for="people-query">Email, IAM ID, or Kerberos ID</label>
            <input id="people-query" name="query" type="text" value="@ViewData["PeopleQuery"]"
                   maxlength="128" required autocomplete="off" aria-describedby="people-query-hint people-query-error" />
            <p class="hint" id="people-query-hint">Enter a complete email address or ID. New users need an IAM ID, Kerberos ID, and email in the campus directory. Existing inactive application accounts cannot sign in.</p>
            <span class="validation-error" id="people-query-error" role="alert">@Html.ValidationMessage("query")</span>
            <button type="submit"><strong>Sign in as this person</strong></button>
        </form>
    </section>
    <section class="person-sign-in" aria-labelledby="normal-sign-in-heading">
        <h2 id="normal-sign-in-heading">Sign in with your account</h2>
        <form action="/login/entra" method="get">
            <input type="hidden" name="returnUrl" value="@Model" />
            <button type="submit" disabled="@(ViewData["NormalLoginAvailable"] is not true)"><strong>Continue to normal login</strong></button>
        </form>
        @if (ViewData["NormalLoginAvailable"] is not true)
        {
            <p class="hint">Normal login is not configured for this development environment.</p>
        }
        <div class="validation-error" role="alert">@Html.ValidationSummary(true)</div>
    </section>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Signed in as <strong>@User.Identity.Name</strong>. <a href="@Model">Continue to the app</a></p>
        <form action="/logout/local" method="post">
            @Html.AntiForgeryToken()
            <button type="submit">Sign out</button>
        </form>
    }
    <p><a href="/about">Visit the public about page</a></p>
</main>
</body>
</html>
