{
  "$schema": "./deployment-settings.schema.json",
  "version": 1,
  "disabled": [],
  "overrides": {},
  "additions": [
    {
      "githubName": "AGGIEENTERPRISE__GRAPHQLURL",
      "appServiceName": "AggieEnterprise__GraphQlUrl",
      "classification": "variable",
      "valueType": "string",
      "description": "Aggie Enterprise HTTPS GraphQL endpoint."
    },
    {
      "githubName": "AGGIEENTERPRISE__CONSUMERKEY",
      "appServiceName": "AggieEnterprise__ConsumerKey",
      "classification": "variable",
      "valueType": "string",
      "description": "Aggie Enterprise OAuth client identifier (consumer key)."
    },
    {
      "githubName": "AGGIEENTERPRISE__CONSUMERSECRET",
      "appServiceName": "AggieEnterprise__ConsumerSecret",
      "classification": "secret",
      "valueType": "string",
      "description": "Aggie Enterprise OAuth client secret."
    },
    {
      "githubName": "AGGIEENTERPRISE__TOKENENDPOINT",
      "appServiceName": "AggieEnterprise__TokenEndpoint",
      "classification": "variable",
      "valueType": "string",
      "description": "Aggie Enterprise HTTPS OAuth token endpoint."
    },
    {
      "githubName": "AGGIEENTERPRISE__SCOPEAPP",
      "appServiceName": "AggieEnterprise__ScopeApp",
      "classification": "variable",
      "valueType": "string",
      "description": "Application portion of the Aggie Enterprise OAuth scope."
    },
    {
      "githubName": "AGGIEENTERPRISE__SCOPEENV",
      "appServiceName": "AggieEnterprise__ScopeEnv",
      "classification": "variable",
      "valueType": "string",
      "description": "Environment portion of the Aggie Enterprise OAuth scope."
    },
    {
      "githubName": "PAYMENTS_BASE_URL",
      "appServiceName": "Payments__BaseUrl",
      "classification": "variable",
      "valueType": "string",
      "description": "Payments API base URL."
    },
    {
      "githubName": "ROSETTACLIENT__BASEURL",
      "appServiceName": "RosettaClient__BaseUrl",
      "classification": "variable",
      "valueType": "string",
      "description": "Rosetta API base URL, optionally containing {version}.",
      "requiredWhen": "always"
    },
    {
      "githubName": "ROSETTACLIENT__TOKENURL",
      "appServiceName": "RosettaClient__TokenUrl",
      "classification": "variable",
      "valueType": "string",
      "description": "Rosetta OAuth token endpoint.",
      "requiredWhen": "always"
    },
    {
      "githubName": "ROSETTACLIENT__CLIENTID",
      "appServiceName": "RosettaClient__ClientId",
      "classification": "variable",
      "valueType": "string",
      "description": "Rosetta OAuth client ID.",
      "requiredWhen": "always"
    },
    {
      "githubName": "ROSETTACLIENT__CLIENTSECRET",
      "appServiceName": "RosettaClient__ClientSecret",
      "classification": "secret",
      "valueType": "string",
      "description": "Rosetta OAuth client secret.",
      "requiredWhen": "always"
    },
    {
      "githubName": "ROSETTACLIENT__SCOPE",
      "appServiceName": "RosettaClient__Scope",
      "classification": "variable",
      "valueType": "string",
      "description": "Optional Rosetta OAuth scope override."
    }
  ]
}
